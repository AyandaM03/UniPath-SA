<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="@string/dialog_add_app_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:text="@string/dialog_add_app_sub"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- University AutoComplete -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.UniPathSA.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/hint_search_university"
        app:startIconDrawable="@android:drawable/ic_menu_search">

        <AutoCompleteTextView
            android:id="@+id/actvAddUni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="1"
            android:inputType="text"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Course AutoComplete -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.UniPathSA.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_search_course"
        app:startIconDrawable="@android:drawable/ic_menu_edit">

        <AutoCompleteTextView
            android:id="@+id/actvAddCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="1"
            android:inputType="text"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Deadline Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.UniPathSA.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_closing_deadline"
        app:startIconDrawable="@android:drawable/ic_menu_today">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAddDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            tools:text="30 Sep 2025"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvSearchStatusHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:text="@string/hint_search_status_default"
        android:textColor="@color/primary"
        android:textSize="11sp"
        tools:ignore="SmallSp" />

</LinearLayout>