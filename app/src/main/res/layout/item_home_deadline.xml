<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.UniPathSA.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_m"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_m">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/logo_box_bg"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_today"
            app:tint="@color/primary"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDeadlineUni"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="University of Cape Town"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_m" />

            <TextView
                android:id="@+id/tvDeadlineCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="BCom Information Systems"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDeadlineDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="Closes: 30 Sep 2025"
                android:textColor="@color/error"
                android:textSize="11sp"
                tools:ignore="SmallSp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDeadlineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/status_submitted_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Submitted"
            android:textColor="@color/status_submitted_fg"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold"
            tools:ignore="SmallSp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>