<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Visual Card Container with Downloaded Intro Photo -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="230dp"
        app:cardBackgroundColor="#1F1A237E"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Intro Page Photo -->
            <ImageView
                android:id="@+id/ivIntroPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <!-- Dark Gradient Overlay for Badge Contrast -->
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/hero_bottom_gradient" />

            <!-- Floating Badge Top Right -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvIntroTopBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_margin="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <TextView
                    android:id="@+id/tvIntroTopBadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:fontFamily="sans-serif-black"
                    android:text="APS 32"
                    android:textColor="@color/navy_dark"
                    android:textSize="12sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Floating Badge Bottom Left -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvIntroBottomBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:layout_margin="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <TextView
                    android:id="@+id/tvIntroBottomBadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="✔ Qualifying Score"
                    android:textColor="@color/status_accepted_fg"
                    android:textSize="12sp" />
            </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Page Title -->
    <TextView
        android:id="@+id/tvIntroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="Automatic APS Calculator"
        android:textColor="@color/white"
        android:textSize="24sp" />

    <!-- Page Subtitle -->
    <TextView
        android:id="@+id/tvIntroSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Calculate your NSC APS score instantly and see which degree programmes you qualify for."
        android:textColor="#CCFFFFFF"
        android:textSize="14sp" />

</LinearLayout>