<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Top Hero Area (260dp tall) -->
        <RelativeLayout
            android:id="@+id/rlHeroHeader"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Hero Campus/Building Photo -->
            <ImageView
                android:id="@+id/ivHeroImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <!-- Gradient Fade to Background at Bottom of Hero -->
            <View
                android:id="@+id/vBottomGradientOverlay"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/hero_bottom_gradient" />

            <!-- Fallback Navy Gradient Header (visible if heroImageUrl is missing/fails) -->
            <LinearLayout
                android:id="@+id/llFallbackHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_header"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivFallbackHeaderLogo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/app_logo"
                    app:tint="@color/white"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvFallbackHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/white"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="@dimen/spacing_m"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />

        </RelativeLayout>

        <!-- Main Content Area with Overlapping Logo -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_m">

            <!-- Fixed 84dp Logo Card Overlapping Lower Edge of Hero by -42dp -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvLogoCard"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginTop="-42dp"
                android:elevation="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivUniLogoLarge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tvFallbackLogoInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_badge"
                        android:gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:text="U"
                        android:textColor="@color/primary"
                        android:textSize="32sp"
                        android:visibility="gone" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save Bookmark Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveUni"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="-20dp"
                android:elevation="12dp"
                android:text="Save"
                app:elevation="8dp"
                app:icon="@android:drawable/btn_star_big_off" />

            <!-- Title & Info Group below Logo Card with sufficient margin -->
            <LinearLayout
                android:id="@+id/llHeaderTitleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/cvLogoCard"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUniName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="University Name"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvUniLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Gauteng • Public University"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvFreeToApplyBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_badge"
                        android:backgroundTint="@color/status_accepted_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Free to apply"
                        android:textColor="@color/status_accepted_fg"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold"
                        android:visibility="gone"
                        tools:ignore="SmallSp" />

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

        <!-- Summary Stats Row -->
        <LinearLayout
            android:id="@+id/llStatsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_m"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.UniPathSA.Card"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="30+"
                        android:textColor="@color/primary"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Min APS"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:ignore="SmallSp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.UniPathSA.Card"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvUserApsDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="35"
                        android:textColor="@color/status_accepted_fg"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your APS"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:ignore="SmallSp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.UniPathSA.Card"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvUniTypeShort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Public"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Type"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:ignore="SmallSp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- About Section Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.UniPathSA.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_s"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="ABOUT THIS INSTITUTION"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvLongDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:text="Institution overview description..."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Entry Requirements Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.UniPathSA.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_s"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="ENTRY REQUIREMENTS &amp; CLOSING DATES"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRequirements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="NSC Bachelor Pass with minimum required marks depending on faculty."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvImportantDates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Closing Date: 30 September"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_l"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVisitWebsite"
                style="@style/Widget.UniPathSA.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Visit Official Website" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyNow"
                style="@style/Widget.UniPathSA.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="Apply Now / Add Application" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>