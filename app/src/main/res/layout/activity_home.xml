<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollViewHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_xl">

                <!-- 1. Top Header Bar -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@drawable/gradient_header"
                    android:paddingHorizontal="@dimen/spacing_m">

                    <ImageView
                        android:id="@+id/btnMenu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:tint="@color/white"
                        tools:ignore="ContentDescription" />

                    <RelativeLayout
                        android:id="@+id/btnNotifications"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_bell_outline"
                            app:tint="@color/white"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/tvNotifBadge"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/error"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:visibility="gone"
                            tools:ignore="SmallSp" />
                    </RelativeLayout>

                </RelativeLayout>

                <!-- 2. Vibrant Greeting Section -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_header"
                    android:paddingHorizontal="@dimen/spacing_m"
                    android:paddingBottom="@dimen/spacing_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/ivHeaderCapIllustration"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHomeGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Hey, Student 👋"
                            android:textColor="@color/white"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/tvHomeSlogan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Find your path. Build your future."
                            android:textColor="#E0E0E0"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Vector Illustration Right -->
                    <ImageView
                        android:id="@+id/ivHeaderCapIllustration"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:alpha="0.8"
                        android:src="@drawable/app_logo"
                        app:tint="@color/white"
                        tools:ignore="ContentDescription" />

                </RelativeLayout>

                <!-- 3. Your Preparation Hero Card (Vivid Gradient in both Light & Dark mode) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvPreparationCard"
                    style="@style/Widget.UniPathSA.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_m"
                    android:layout_marginTop="-18dp"
                    app:cardBackgroundColor="@color/navy_dark"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gradient_header"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Left: Circular Percentage Ring -->
                            <RelativeLayout
                                android:layout_width="64dp"
                                android:layout_height="64dp">

                                <ProgressBar
                                    android:id="@+id/pbPreparation"
                                    style="@android:style/Widget.ProgressBar.Horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:indeterminate="false"
                                    android:max="100"
                                    android:progress="42"
                                    android:progressDrawable="@drawable/bg_badge"
                                    android:progressTint="@color/white" />

                                <TextView
                                    android:id="@+id/tvPreparationPercentage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:fontFamily="sans-serif-black"
                                    android:text="0%"
                                    android:textColor="@color/white"
                                    android:textSize="18sp" />
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:letterSpacing="0.05"
                                    android:text="YOUR PREPARATION"
                                    android:textColor="#E3F2FD"
                                    android:textSize="11sp"
                                    tools:ignore="SmallSp" />

                                <TextView
                                    android:id="@+id/tvPreparationSummary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="You're 0 steps in, keep going!"
                                    android:textColor="@color/white"
                                    android:textSize="14sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNextStep"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="-4dp"
                                    android:fontFamily="sans-serif-bold"
                                    android:padding="0dp"
                                    android:text="Next Step →"
                                    android:textColor="@color/white"
                                    android:textSize="12sp" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Status chips for tasks -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/cgPreparationChips"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:singleLine="true" />
                        </HorizontalScrollView>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. 2x2 Grid of Stat Cards (Readable text contrast in Light & Dark Mode) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_s"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:orientation="vertical">

                    <!-- Row 1: APS & Eligible Courses -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Stat 1: Your APS (Blue Tile) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvStatAps"
                            style="@style/Widget.UniPathSA.Card"
                            android:layout_width="0dp"
                            android:layout_height="115dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="YOUR APS"
                                    android:textColor="@color/primary"
                                    android:textSize="11sp"
                                    tools:ignore="SmallSp" />

                                <TextView
                                    android:id="@+id/tvStatApsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-black"
                                    android:gravity="center"
                                    android:text="Not calculated"
                                    android:textColor="@color/text_primary"
                                    android:textSize="20sp" />

                                <TextView
                                    android:id="@+id/btnStatApsAction"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="Calculate APS →"
                                    android:textColor="@color/primary"
                                    android:textSize="11sp"
                                    tools:ignore="SmallSp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Stat 2: Eligible Courses (Green Tile) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvStatEligible"
                            style="@style/Widget.UniPathSA.Card"
                            android:layout_width="0dp"
                            android:layout_height="115dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="ELIGIBLE COURSES"
                                    android:textColor="@color/status_accepted_fg"
                                    android:textSize="11sp"
                                    tools:ignore="SmallSp" />

                                <TextView
                                    android:id="@+id/tvStatEligibleValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-black"
                                    android:text="0"
                                    android:textColor="@color/status_accepted_fg"
                                    android:textSize="28sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Matching Courses"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"
                                    tools:ignore="SmallSp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Row 2: Applications & Saved Items -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Stat 3: Applications (Orange Tile) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvStatApplications"
                            style="@style/Widget.UniPathSA.Card"
                            android:layout_width="0dp"
                            android:layout_height="115dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="APPLICATIONS"
                                    android:textColor="@color/status_review_fg"
                                    android:textSize="11sp"
                                    tools:ignore="SmallSp" />

                                <TextView
                                    android:id="@+id/tvStatApplicationsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-black"
                                    android:text="0"
                                    android:textColor="@color/status_review_fg"
                                    android:textSize="28sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Active Tracker"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"
                                    tools:ignore="SmallSp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Stat 4: Saved Items (Pink Tile) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvStatSaved"
                            style="@style/Widget.UniPathSA.Card"
                            android:layout_width="0dp"
                            android:layout_height="115dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="SAVED ITEMS"
                                    android:textColor="@color/purple_accent"
                                    android:textSize="11sp"
                                    tools:ignore="SmallSp" />

                                <TextView
                                    android:id="@+id/tvStatSavedValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-black"
                                    android:text="0"
                                    android:textColor="@color/purple_accent"
                                    android:textSize="28sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Saved Items"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"
                                    tools:ignore="SmallSp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                </LinearLayout>

                <!-- 5. Explore Institutions Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_m"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="🏫 EXPLORE INSTITUTIONS"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSeeAllInstitutions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="View all"
                        android:textColor="@color/primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHomeInstitutions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/spacing_m"
                    tools:listitem="@layout/item_home_institution" />

                <!-- 6. Upcoming Deadlines Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_m"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="📅 UPCOMING DEADLINES"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSeeAllDeadlines"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="View all"
                        android:textColor="@color/primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Empty state for deadlines -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvEmptyDeadlines"
                    style="@style/Widget.UniPathSA.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_m"
                    android:layout_marginTop="@dimen/spacing_s"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_m">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="No upcoming application deadlines tracked yet."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddDeadlineApp"
                            style="@style/Widget.UniPathSA.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="@dimen/spacing_s"
                            android:text="+ Add Application" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUpcomingDeadlines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    tools:listitem="@layout/item_home_deadline" />

                <!-- 7. Recommended for You Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_m"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="⭐ RECOMMENDED FOR YOU"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSeeAllCourses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Explore all"
                        android:textColor="@color/primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Prompt when APS is 0 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvApsPrompt"
                    style="@style/Widget.UniPathSA.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_m"
                    android:layout_marginTop="@dimen/spacing_s"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_dialog_info"
                            app:tint="@color/primary"
                            tools:ignore="ContentDescription" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_s"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Find courses you qualify for"
                                android:textColor="@color/primary"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Calculate your APS to unlock course recommendations."
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                tools:ignore="SmallSp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCalculateApsPrompt"
                            style="@style/Widget.UniPathSA.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:text="Calculate"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Horizontally Scrolling Recommended Courses -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecommendedCourses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/spacing_m"
                    tools:listitem="@layout/item_home_course" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include layout="@layout/nav_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>