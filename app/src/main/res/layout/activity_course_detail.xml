<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Header Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/gradient_header"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="@dimen/spacing_s"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_revert"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />

            <RelativeLayout
                android:id="@+id/btnNotifications"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="@dimen/spacing_s"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_bell_outline"
                    app:tint="@color/white"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvNotifBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_badge"
                    android:backgroundTint="@color/error"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:ignore="SmallSp" />
            </RelativeLayout>

            <ImageView
                android:id="@+id/ivCourseUniHeaderLogo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginBottom="8dp"
                android:background="@drawable/logo_box_bg"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/unipath_logo"
                app:layout_constraintBottom_toTopOf="@+id/tvCourseTitle"
                app:layout_constraintStart_toStartOf="parent"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvCourseTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_l"
                android:layout_marginBottom="@dimen/spacing_m"
                android:fontFamily="sans-serif-black"
                android:text="BSc Computer Science"
                android:textColor="@color/white"
                android:textSize="28sp"
                app:layout_constraintBottom_toTopOf="@+id/tvInstitutionTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvInstitutionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_l"
                android:layout_marginBottom="@dimen/spacing_l"
                android:fontFamily="sans-serif-medium"
                android:text="University of the Witwatersrand"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/text_body_m"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Eligibility Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvMatchStatus"
            style="@style/Widget.UniPathSA.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_m"
            android:layout_marginTop="-30dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m">

                <ImageView
                    android:id="@+id/ivStatusIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/presence_online"
                    app:tint="#2E7D32"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMatchStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="You are Eligible"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body_m" />

                    <TextView
                        android:id="@+id/tvMatchDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Based on your current subjects and marks."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:ignore="SmallSp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveCourse"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save"
                    app:icon="@drawable/ic_bookmark_outline" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Course Info Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvDetails"
            style="@style/Widget.UniPathSA.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_s"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/cvMatchStatus">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="About this Course"
                    android:textColor="@color/primary_dark"
                    android:textSize="@dimen/text_body_m" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:text="Description goes here..."
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_s" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/spacing_m"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Duration" android:textSize="11sp" android:textColor="@color/text_tertiary" tools:ignore="SmallSp"/>
                        <TextView android:id="@+id/tvDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 Years" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Field" android:textSize="11sp" android:textColor="@color/text_tertiary" tools:ignore="SmallSp"/>
                        <TextView android:id="@+id/tvFieldDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Science" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Requirements Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvRequirements"
            style="@style/Widget.UniPathSA.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_s"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/cvDetails">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Admission Requirements"
                    android:textColor="@color/primary_dark"
                    android:textSize="@dimen/text_body_m" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:background="@drawable/rounded_edittext"
                    android:backgroundTint="#F5F5F5"
                    android:padding="@dimen/spacing_s"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Required APS Score" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium"/>
                    <TextView android:id="@+id/tvApsRequirement" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="34" android:textColor="@color/primary" android:fontFamily="sans-serif-black" android:textSize="20sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:text="Subject Requirements:"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvSubjectRequirements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="• Mathematics: 70%\n• English: 60%"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_s" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyInfo"
            style="@style/Widget.UniPathSA.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginHorizontal="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="View Application Info"
            app:layout_constraintTop_toBottomOf="@id/cvRequirements" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenCalc"
            style="@style/Widget.UniPathSA.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginHorizontal="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="Open APS Calculator"
            app:layout_constraintTop_toBottomOf="@id/btnApplyInfo" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>